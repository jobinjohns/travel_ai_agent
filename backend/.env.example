# Copy this file to .env and fill in your real values
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_agent_db
GROQ_API_KEY=your_groq_api_key_here
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_string
# Alternative LLM — only needed if you switch to Gemini, see README
# GOOGLE_API_KEY=your_gemini_api_key_here
